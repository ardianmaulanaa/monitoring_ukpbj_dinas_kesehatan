generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  ACTIVE
  INACTIVE
}

enum RoleCode {
  SUPER_ADMIN
  LPSE_ADMIN
  OPERATOR
  LEADER
  PPTK
  PA
  KPA
  PPK
  PROCUREMENT_OFFICER
  SELECTION_WORKGROUP
  UKPBJ
  AUDITOR
  VIEWER
}

enum AuditAction {
  LOGIN
  LOGOUT
  CREATE
  UPDATE
  DELETE
  APPROVE
  REJECT
  EXPORT
}

enum BarangPrioritas {
  RENDAH
  NORMAL
  TINGGI
  MENDESAK
}

enum BarangStatus {
  AKTIF
  NONAKTIF
}

enum PaketJenisPengadaan {
  BARANG
  JASA
}

enum PaketMetodePengadaan {
  TENDER
  NON_TENDER
  E_PURCHASING
  PENGADAAN_LANGSUNG
  SWAKELOLA
}

enum PaketStatus {
  PERENCANAAN
  SIAP_DIPROSES
  PEMILIHAN
  PEMENANG_DITETAPKAN
  KONTRAK
  SELESAI
  GAGAL
  BATAL
  TERLAMBAT
}

enum RupStatus {
  BELUM_INPUT
  PROSES_VERIFIKASI
  MENUNGGU_PPTK
  MENUNGGU_PPK
  MENUNGGU_KPA_PA
  SUDAH_TAYANG
  REVISI_PAGU
  DITARIK
}

enum KontrakStatus {
  DRAFT
  AKTIF
  SELESAI
  TERLAMBAT
  BATAL
}

enum RisikoLevel {
  RENDAH
  SEDANG
  TINGGI
}

enum RisikoStatus {
  PERLU_TINDAK_LANJUT
  PROSES
  SELESAI
}

enum PenyediaStatus {
  AKTIF
  NONAKTIF
  BLACKLIST
}

enum TimelineStatus {
  RENCANA
  BERJALAN
  SELESAI
  TERLAMBAT
}

enum AuditDokumenStatus {
  BELUM_ADA
  PROSES
  LENGKAP
}

enum KlinikStatus {
  BARU
  DIPROSES
  SELESAI
}

enum DokumenJenis {
  DOKUMEN
  TEMPLATE
}

enum DokumenStatus {
  DRAFT
  AKTIF
  NONAKTIF
}

enum LaporanJenis {
  PAKET
  REALISASI
  KONTRAK
  RISIKO
  AUDIT
}

enum LaporanStatus {
  DRAFT
  TERBIT
  ARSIP
}

model User {
  id           String     @id @default(uuid()) @db.Char(36)
  name         String     @db.VarChar(160)
  email        String     @unique @db.VarChar(180)
  passwordHash String     @map("password_hash") @db.VarChar(255)
  nip          String?    @db.VarChar(40)
  jabatan      String?    @db.VarChar(120)
  unitKerja    String?    @map("unit_kerja") @db.VarChar(160)
  nomorTelepon String?    @map("nomor_telepon") @db.VarChar(40)
  avatarUrl    String?    @map("avatar_url") @db.VarChar(255)
  status       UserStatus @default(ACTIVE)
  lastLoginAt  DateTime?  @map("last_login_at")
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")

  roles     UserRole[]
  auditLogs AuditLog[]

  @@index([name])
  @@index([status])
  @@map("users")
}

model Role {
  id          String   @id @default(uuid()) @db.Char(36)
  code        RoleCode @unique
  name        String   @db.VarChar(120)
  description String?  @db.VarChar(255)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  users UserRole[]

  @@map("roles")
}

model UserRole {
  id        String   @id @default(uuid()) @db.Char(36)
  userId    String   @map("user_id") @db.Char(36)
  roleId    String   @map("role_id") @db.Char(36)
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId])
  @@index([roleId])
  @@map("user_roles")
}

model AuditLog {
  id        String      @id @default(uuid()) @db.Char(36)
  userId    String?     @map("user_id") @db.Char(36)
  action    AuditAction
  entity    String      @db.VarChar(120)
  entityId  String?     @map("entity_id") @db.VarChar(120)
  before    Json?
  after     Json?
  ipAddress String?     @map("ip_address") @db.VarChar(80)
  userAgent String?     @map("user_agent") @db.VarChar(255)
  createdAt DateTime    @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([action])
  @@index([entity])
  @@index([createdAt])
  @@map("audit_logs")
}

model DataBarang {
  id               String          @id @default(uuid()) @db.Char(36)
  kodeBarang       String          @unique @map("kode_barang") @db.VarChar(80)
  namaBarang       String          @map("nama_barang") @db.VarChar(180)
  kategori         String          @db.VarChar(80)
  spesifikasi      String          @db.Text
  satuan           String          @db.VarChar(40)
  jumlahKebutuhan  Int             @default(0) @map("jumlah_kebutuhan")
  hargaSatuan      Decimal         @default(0) @map("harga_satuan") @db.Decimal(18, 2)
  estimasiTotal    Decimal         @default(0) @map("estimasi_total") @db.Decimal(18, 2)
  tkdnPersen       Decimal?        @map("tkdn_persen") @db.Decimal(5, 2)
  isPdn            Boolean         @default(false) @map("is_pdn")
  prioritas        BarangPrioritas @default(NORMAL)
  lokasiPenerimaan String?         @map("lokasi_penerimaan") @db.VarChar(160)
  catatan          String?         @db.Text
  status           BarangStatus    @default(AKTIF)
  createdAt        DateTime        @default(now()) @map("created_at")
  updatedAt        DateTime        @updatedAt @map("updated_at")

  @@index([namaBarang])
  @@index([kategori])
  @@index([prioritas])
  @@index([status])
  @@map("data_barang")
}

model PaketPengadaan {
  id                 String               @id @default(uuid()) @db.Char(36)
  kodePaket          String               @unique @map("kode_paket") @db.VarChar(80)
  namaPaket          String               @map("nama_paket") @db.VarChar(220)
  unitPemohon        String               @map("unit_pemohon") @db.VarChar(160)
  satuanKerja        String?              @map("satuan_kerja") @db.VarChar(160)
  tahunAnggaran      Int                  @map("tahun_anggaran")
  sumberDana         String               @map("sumber_dana") @db.VarChar(120)
  jenisPengadaan     PaketJenisPengadaan  @default(BARANG) @map("jenis_pengadaan")
  kategori           String               @db.VarChar(100)
  metodePengadaan    PaketMetodePengadaan @map("metode_pengadaan")
  pagu               Decimal              @default(0) @db.Decimal(18, 2)
  hps                Decimal              @default(0) @db.Decimal(18, 2)
  statusPaket        PaketStatus          @default(PERENCANAAN) @map("status_paket")
  prioritas          BarangPrioritas      @default(NORMAL)
  ppkPenanggungJawab String?              @map("ppk_penanggung_jawab") @db.VarChar(160)
  rencanaMulai       DateTime?            @map("rencana_mulai") @db.Date
  rencanaSelesai     DateTime?            @map("rencana_selesai") @db.Date
  lokasiPelaksanaan  String?              @map("lokasi_pelaksanaan") @db.VarChar(180)
  catatan            String?              @db.Text
  createdAt          DateTime             @default(now()) @map("created_at")
  updatedAt          DateTime             @updatedAt @map("updated_at")

  risikoMitigasi RisikoMitigasi[]
  realisasi      RealisasiBelanja[]
  progres        ProgresPaket[]
  serahTerima    SerahTerima[]
  timelineEvents TimelineEvent[]
  auditDokumen   AuditChecklist[]

  @@index([namaPaket])
  @@index([unitPemohon])
  @@index([tahunAnggaran])
  @@index([kategori])
  @@index([metodePengadaan])
  @@index([statusPaket])
  @@map("paket_pengadaan")
}

model Kontrak {
  id             String        @id @default(uuid()) @db.Char(36)
  nomorKontrak   String        @unique @map("nomor_kontrak") @db.VarChar(100)
  paketId        String?       @map("paket_id") @db.Char(36)
  namaPaket      String        @map("nama_paket") @db.VarChar(220)
  penyedia       String        @db.VarChar(180)
  nilaiKontrak   Decimal       @default(0) @map("nilai_kontrak") @db.Decimal(18, 2)
  tanggalKontrak DateTime?     @map("tanggal_kontrak") @db.Date
  tanggalMulai   DateTime?     @map("tanggal_mulai") @db.Date
  tanggalSelesai DateTime?     @map("tanggal_selesai") @db.Date
  status         KontrakStatus @default(DRAFT)
  catatan        String?       @db.Text
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")

  realisasi      RealisasiBelanja[]
  serahTerima    SerahTerima[]
  timelineEvents TimelineEvent[]

  @@index([paketId])
  @@index([namaPaket])
  @@index([penyedia])
  @@index([status])
  @@map("kontrak")
}

model RencanaUmumPengadaan {
  id              String               @id @default(uuid()) @db.Char(36)
  kodeRup         String               @unique @map("kode_rup") @db.VarChar(80)
  namaPaket       String               @map("nama_paket") @db.VarChar(220)
  unitPengusul    String               @map("unit_pengusul") @db.VarChar(160)
  sumberDana      String               @map("sumber_dana") @db.VarChar(120)
  pagu            Decimal              @default(0) @db.Decimal(18, 2)
  metodePengadaan PaketMetodePengadaan @map("metode_pengadaan")
  jadwalPemilihan String?              @map("jadwal_pemilihan") @db.VarChar(120)
  tahunAnggaran   Int                  @map("tahun_anggaran")
  statusSirup     RupStatus            @default(BELUM_INPUT) @map("status_sirup")
  catatan         String?              @db.Text
  createdAt       DateTime             @default(now()) @map("created_at")
  updatedAt       DateTime             @updatedAt @map("updated_at")

  @@index([namaPaket])
  @@index([unitPengusul])
  @@index([sumberDana])
  @@index([tahunAnggaran])
  @@index([metodePengadaan])
  @@index([statusSirup])
  @@map("rencana_umum_pengadaan")
}

model SumberDana {
  id        String   @id @default(uuid()) @db.Char(36)
  kode      String   @unique @db.VarChar(40)
  nama      String   @db.VarChar(120)
  aktif     Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([nama])
  @@index([aktif])
  @@map("sumber_dana")
}

model RisikoMitigasi {
  id        String       @id @default(uuid()) @db.Char(36)
  paketId   String?      @map("paket_id") @db.Char(36)
  risiko    String       @db.Text
  level     RisikoLevel  @default(SEDANG)
  mitigasi  String       @db.Text
  pic       String       @db.VarChar(160)
  deadline  DateTime?    @db.Date
  status    RisikoStatus @default(PERLU_TINDAK_LANJUT)
  catatan   String?      @db.Text
  createdAt DateTime     @default(now()) @map("created_at")
  updatedAt DateTime     @updatedAt @map("updated_at")

  paket PaketPengadaan? @relation(fields: [paketId], references: [id], onDelete: SetNull)

  @@index([paketId])
  @@index([level])
  @@index([status])
  @@index([deadline])
  @@map("risiko_mitigasi")
}

model Penyedia {
  id           String         @id @default(uuid()) @db.Char(36)
  nama         String         @unique @db.VarChar(180)
  npwp         String?        @db.VarChar(40)
  alamat       String?        @db.Text
  kontakPerson String?        @map("kontak_person") @db.VarChar(120)
  email        String?        @db.VarChar(180)
  telepon      String?        @db.VarChar(40)
  kategori     String?        @db.VarChar(100)
  status       PenyediaStatus @default(AKTIF)
  catatan      String?        @db.Text
  createdAt    DateTime       @default(now()) @map("created_at")
  updatedAt    DateTime       @updatedAt @map("updated_at")

  @@index([nama])
  @@index([status])
  @@map("penyedia")
}

model RealisasiBelanja {
  id             String    @id @default(uuid()) @db.Char(36)
  paketId        String?   @map("paket_id") @db.Char(36)
  kontrakId      String?   @map("kontrak_id") @db.Char(36)
  sumberDana     String    @map("sumber_dana") @db.VarChar(120)
  tahunAnggaran  Int       @map("tahun_anggaran")
  nilaiPagu      Decimal   @default(0) @map("nilai_pagu") @db.Decimal(18, 2)
  nilaiHps       Decimal   @default(0) @map("nilai_hps") @db.Decimal(18, 2)
  nilaiKontrak   Decimal   @default(0) @map("nilai_kontrak") @db.Decimal(18, 2)
  nilaiRealisasi Decimal   @default(0) @map("nilai_realisasi") @db.Decimal(18, 2)
  tanggalBayar   DateTime? @map("tanggal_bayar") @db.Date
  nomorBukti     String?   @map("nomor_bukti") @db.VarChar(100)
  catatan        String?   @db.Text
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  paket   PaketPengadaan? @relation(fields: [paketId], references: [id], onDelete: SetNull)
  kontrak Kontrak?        @relation(fields: [kontrakId], references: [id], onDelete: SetNull)

  @@index([paketId])
  @@index([kontrakId])
  @@index([sumberDana])
  @@index([tahunAnggaran])
  @@map("realisasi_belanja")
}

model ProgresPaket {
  id         String         @id @default(uuid()) @db.Char(36)
  paketId    String?        @map("paket_id") @db.Char(36)
  tahap      String         @db.VarChar(120)
  persentase Int            @default(0)
  status     TimelineStatus @default(BERJALAN)
  tanggal    DateTime?      @db.Date
  catatan    String?        @db.Text
  createdAt  DateTime       @default(now()) @map("created_at")
  updatedAt  DateTime       @updatedAt @map("updated_at")

  paket PaketPengadaan? @relation(fields: [paketId], references: [id], onDelete: SetNull)

  @@index([paketId])
  @@index([status])
  @@map("progres_paket")
}

model SerahTerima {
  id             String         @id @default(uuid()) @db.Char(36)
  paketId        String?        @map("paket_id") @db.Char(36)
  kontrakId      String?        @map("kontrak_id") @db.Char(36)
  nomorDokumen   String         @unique @map("nomor_dokumen") @db.VarChar(100)
  tanggalDokumen DateTime?      @map("tanggal_dokumen") @db.Date
  pemeriksa      String?        @db.VarChar(160)
  status         TimelineStatus @default(BERJALAN)
  catatan        String?        @db.Text
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @updatedAt @map("updated_at")

  paket   PaketPengadaan? @relation(fields: [paketId], references: [id], onDelete: SetNull)
  kontrak Kontrak?        @relation(fields: [kontrakId], references: [id], onDelete: SetNull)

  @@index([paketId])
  @@index([kontrakId])
  @@index([status])
  @@map("serah_terima")
}

model TimelineEvent {
  id             String         @id @default(uuid()) @db.Char(36)
  paketId        String?        @map("paket_id") @db.Char(36)
  kontrakId      String?        @map("kontrak_id") @db.Char(36)
  judul          String         @db.VarChar(180)
  tahap          String         @db.VarChar(120)
  unitKerja      String?        @map("unit_kerja") @db.VarChar(160)
  tanggalMulai   DateTime?      @map("tanggal_mulai") @db.Date
  tanggalSelesai DateTime?      @map("tanggal_selesai") @db.Date
  status         TimelineStatus @default(RENCANA)
  catatan        String?        @db.Text
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @updatedAt @map("updated_at")

  paket   PaketPengadaan? @relation(fields: [paketId], references: [id], onDelete: SetNull)
  kontrak Kontrak?        @relation(fields: [kontrakId], references: [id], onDelete: SetNull)

  @@index([paketId])
  @@index([kontrakId])
  @@index([status])
  @@map("timeline_events")
}

model AuditChecklist {
  id        String             @id @default(uuid()) @db.Char(36)
  paketId   String?            @map("paket_id") @db.Char(36)
  dokumen   String             @db.VarChar(160)
  status    AuditDokumenStatus @default(BELUM_ADA)
  catatan   String?            @db.Text
  createdAt DateTime           @default(now()) @map("created_at")
  updatedAt DateTime           @updatedAt @map("updated_at")

  paket PaketPengadaan? @relation(fields: [paketId], references: [id], onDelete: SetNull)

  @@unique([paketId, dokumen])
  @@index([status])
  @@map("audit_checklist")
}

model KlinikKonsultasi {
  id         String       @id @default(uuid()) @db.Char(36)
  unitKerja  String       @map("unit_kerja") @db.VarChar(160)
  jenis      String       @db.VarChar(120)
  pertanyaan String       @db.Text
  jawaban    String?      @db.Text
  status     KlinikStatus @default(BARU)
  createdAt  DateTime     @default(now()) @map("created_at")
  updatedAt  DateTime     @updatedAt @map("updated_at")

  @@index([unitKerja])
  @@index([jenis])
  @@index([status])
  @@map("klinik_konsultasi")
}

model DokumenTemplate {
  id        String        @id @default(uuid()) @db.Char(36)
  nama      String        @db.VarChar(180)
  jenis     DokumenJenis  @default(DOKUMEN)
  kategori  String?       @db.VarChar(120)
  fileUrl   String?       @map("file_url") @db.VarChar(255)
  status    DokumenStatus @default(AKTIF)
  catatan   String?       @db.Text
  createdAt DateTime      @default(now()) @map("created_at")
  updatedAt DateTime      @updatedAt @map("updated_at")

  @@index([nama])
  @@index([jenis])
  @@index([status])
  @@map("dokumen_template")
}

model LaporanTersimpan {
  id            String        @id @default(uuid()) @db.Char(36)
  judul         String        @db.VarChar(180)
  jenis         LaporanJenis
  tahunAnggaran Int?          @map("tahun_anggaran")
  periode       String?       @db.VarChar(80)
  fileUrl       String?       @map("file_url") @db.VarChar(255)
  status        LaporanStatus @default(DRAFT)
  catatan       String?       @db.Text
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")

  @@index([jenis])
  @@index([tahunAnggaran])
  @@index([status])
  @@map("laporan_tersimpan")
}
